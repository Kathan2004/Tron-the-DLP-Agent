# Tron DLP Agent - environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- Console authentication (required for anything beyond local dev) ---
# Secret used to sign console auth tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is generated per run and all sessions end on restart.
APP_AUTH_SECRET=your-random-auth-secret
# Initial admin account (only used when the user table is empty).
# If APP_ADMIN_PASSWORD is unset, a random password is generated, printed once,
# and must be changed on first login.
APP_ADMIN_EMAIL=admin@tron.local
APP_ADMIN_PASSWORD=
# Comma-separated origins allowed to call the console API.
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Telegram alerting ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
SECURITY_CHAT_ID=your-telegram-chat-id

# --- Google Cloud / Gemini (LLM triage) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_PATH=./config/service-account.json
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# --- Slack (optional) ---
SLACK_WEBHOOK_URL=

# --- Jira (optional) ---
JIRA_SERVER=
JIRA_USER=
JIRA_TOKEN=

# --- API server ---
FLASK_PORT=5001
FLASK_HOST=127.0.0.1
DEBUG=False

# --- Redis (optional, for caching) ---
REDIS_URL=redis://localhost:6379

# --- ./start only: optional ngrok reserved domain for a public tunnel ---
NGROK_DOMAIN=
