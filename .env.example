# Tron DLP: environment configuration.
# Copy to .env (./setup.sh does this and generates the three secrets below). Never commit .env.

# --- Required for anything beyond a throwaway local run ---------------------------------
# Signs console session tokens.  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_AUTH_SECRET=
# Enrollment token. Agents and the extension present it once to obtain their own key.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRON_AGENT_TOKEN=
# open | token | strict. Leave empty while rolling out, then set strict so only
# per-agent keys are accepted on ingest.
TRON_AGENT_AUTH=
# 32-byte base64 key that encrypts findings, payload samples and captured files at rest.
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If empty, a key file is created next to the database (data/.data.key).
TRON_DATA_KEY=

# --- Console bootstrap ------------------------------------------------------------------
# Used only while the user table is empty. Without a password a one-time one is printed.
APP_ADMIN_EMAIL=admin@tron.local
APP_ADMIN_PASSWORD=
# Browser origins allowed to call the API cross-origin (not needed behind the bundled
# reverse proxy, where console and API share an origin).
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- API server -------------------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
DEBUG=False
# Number of reverse proxies in front of the API whose X-Forwarded-* headers are trusted.
TRON_TRUSTED_PROXIES=0
# text | json
TRON_LOG_FORMAT=text
# Bearer token for GET /api/metrics (Prometheus). Empty = endpoint disabled.
TRON_METRICS_TOKEN=

# --- Agents only ------------------------------------------------------------------------
# Base64 Ed25519 public key that signed upgrades must verify against
# (python scripts/sign_agent_update.py keygen). Empty = remote upgrades disabled.
TRON_UPDATE_PUBKEY=

# --- Optional integrations --------------------------------------------------------------
# Telegram alerts
TELEGRAM_BOT_TOKEN=
SECURITY_CHAT_ID=
# Gemini LLM triage (values are redacted before any prompt is built)
GOOGLE_GENAI_API_KEY=
# Slack / Jira escalation
SLACK_WEBHOOK_URL=
JIRA_SERVER=
JIRA_USER=
JIRA_TOKEN=

# --- docker compose --profile tls -------------------------------------------------------
TRON_DOMAIN=
# --- ./start only: optional ngrok reserved domain ---------------------------------------
NGROK_DOMAIN=
