{
    "manifest_version": 3,
    "name": "TRON THE DLP AGENT — File Upload Guard",
    "version": "1.0.2",
    "description": "Scans files for sensitive data before they are uploaded to any website. Part of the TRON THE DLP AGENT system.",
    "permissions": [
        "storage",
        "notifications",
        "activeTab",
        "downloads",
        "geolocation",
        "identity",
        "identity.email"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://localhost:5000/*",
        "http://localhost:5001/*",
        "https://generativelanguage.googleapis.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}