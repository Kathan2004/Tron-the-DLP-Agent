# TLS termination for the Tron stack (docker compose --profile tls).
# With a public DNS name in TRON_DOMAIN, Caddy obtains and renews a certificate
# automatically. For an internal name, replace the site block's TLS with your own
# certificate:  tls /certs/fullchain.pem /certs/privkey.pem
{$TRON_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy console:8080 {
		flush_interval -1
	}
}
