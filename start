#!/bin/bash
# TRON THE DLP AGENT — Unified Startup
# Launches Frontend + Backend (+ optional Ngrok tunnel)

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

echo -e "${BLUE}Stopping existing processes...${NC}"
pkill -f "python3 main.py" > /dev/null 2>&1
pkill -f "vite" > /dev/null 2>&1
pkill -f "ngrok" > /dev/null 2>&1
lsof -ti:5001 | xargs kill -9 2>/dev/null
lsof -ti:5173 | xargs kill -9 2>/dev/null

echo -e "${GREEN}Starting Backend (TRON API)...${NC}"
VENV_ACTIVATED=0
if [ -d ".venv" ]; then
    source .venv/bin/activate
    VENV_ACTIVATED=1
elif [ -d "venv" ]; then
    source venv/bin/activate
    VENV_ACTIVATED=1
fi

if [ "$VENV_ACTIVATED" -eq 1 ]; then
    echo -e "  Python Env: $(python3 -c 'import sys; print(sys.executable)')"
else
    echo -e "${YELLOW}  Python Env: system python3 (no venv found)${NC}"
fi
nohup python3 main.py > backend.log 2>&1 &
BACKEND_PID=$!
echo -e "  PID: $BACKEND_PID"

echo -e "${GREEN}Starting Frontend (SIEM Console)...${NC}"
cd siem-console
if [ ! -d "node_modules" ]; then
    echo -e "${YELLOW}  (Installing dependencies first...)${NC}"
    npm install > /dev/null 2>&1
fi
nohup npm run dev > ../frontend.log 2>&1 &
FRONTEND_PID=$!
echo -e "  PID: $FRONTEND_PID"
cd ..

# Optional public tunnel: set NGROK_DOMAIN (in the environment or .env) to enable.
if [ -z "$NGROK_DOMAIN" ] && [ -f .env ]; then
    NGROK_DOMAIN=$(grep -E '^NGROK_DOMAIN=' .env | tail -n1 | cut -d= -f2-)
fi
if [ -n "$NGROK_DOMAIN" ]; then
    echo -e "${GREEN}Starting Ngrok Tunnel...${NC}"
    nohup ngrok http --domain="$NGROK_DOMAIN" 5001 > ngrok.log 2>&1 &
    NGROK_PID=$!
    echo -e "  PID: $NGROK_PID"
else
    echo -e "${YELLOW}Skipping Ngrok Tunnel (NGROK_DOMAIN not set)${NC}"
fi

sleep 2

echo ""
echo -e "${YELLOW}╔═════════════════════════════════════════════╗${NC}"
echo -e "${YELLOW}║   TRON DLP SYSTEM IS LIVE                   ║${NC}"
echo -e "${YELLOW}╚═════════════════════════════════════════════╝${NC}"
echo ""
echo -e "  DLP Backend:      http://localhost:5001"
echo -e "  SIEM Console:     ${GREEN}http://localhost:5173${NC}"
if [ -n "$NGROK_DOMAIN" ]; then
    echo -e "  Public Endpoint:  ${BLUE}https://$NGROK_DOMAIN${NC}"
fi
echo ""
echo -e "  - Inspect Backend:  tail -f backend.log"
echo -e "  - Inspect Frontend: tail -f frontend.log"
[ -n "$NGROK_DOMAIN" ] && echo -e "  - Inspect Ngrok:    tail -f ngrok.log"
echo ""
echo -e "  To stop everything: ${RED}./stop${NC}"
echo ""
